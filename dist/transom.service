[Unit]
Description=Screen sharing, screenshots and settings for apps
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.quire
ExecStart=/usr/libexec/transom
Restart=on-failure
RestartSec=2
# This process can capture the screen and reads the person's home, so it is shut in as far as it
# can be without a mount namespace (a user unit gets one only where unprivileged user namespaces
# are allowed, which Ubuntu 24.04 restricts): it may not gain privileges, speak anything but local
# sockets (the bus, the display, PipeWire), or switch its execution domain. ProtectSystem=strict,
# with the pictures folder and the state folder writable, would also fit once every supported
# distribution allows mount namespaces for user units.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# A loader variable from the user's environment must not load code into a trusted process.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE

[Install]
WantedBy=graphical-session.target
